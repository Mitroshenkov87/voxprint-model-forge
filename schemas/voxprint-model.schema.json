{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voxprint.dev/schemas/voxprint-model/1",
  "title": "voxprint-model/1",
  "description": "Shared model manifest, schema id voxprint-model/1. The properties in required are mandatory. mirror_policy and file_groups are optional; a missing mirror_policy means race. license is the SPDX id, spelled license. VRAM fields are GiB: a 24 GB card is recorded as about 23.5 GiB (GB * 1000 / 1024, nearest 0.5). files[].path is relative to the repo root and is the same string on every mirror. sources on a file or a file group replaces mirrors for those paths. voxprint-model.json is not listed in files. prebuilt is an optional list of recorded alternatives (id, role, replaces, files, note); an entry with role fallback replaces the default files under replaces when the default source fails or the fallback is chosen. A mirror may set ours: true. onnx_prebuilt (on the model or on a file) is an optional pre-built ONNX artifact with built_for.onnxruntime and built_for.opset; a stale one falls back to the source files and post_install. post_install runs the owning app's own installed CLI with only the {id} {model_dir} {source_path} {prebuilt_path} {cache_dir} placeholders; outputs are relative to the model folder.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "display_name",
    "app_ids",
    "task",
    "license",
    "files",
    "mirrors",
    "tier",
    "runtime",
    "base_model",
    "card_url",
    "flags",
    "on_demand",
    "build"
  ],
  "properties": {
    "schema": {
      "const": "voxprint-model/1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "app_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9.+-]*$",
      "description": "Lowercase SPDX licence id. The key is license, not licence."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!voxprint-model\\.json$)(?!/)(?!.*\\\\)(?!.*\\.\\./)[^\\\\]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mirror_policy": {
            "enum": [
              "race",
              "strict-priority"
            ]
          },
          "sources": {
            "$ref": "#/$defs/mirrors"
          },
          "onnx_prebuilt": {
            "$ref": "#/$defs/onnx_prebuilt"
          }
        }
      }
    },
    "mirrors": {
      "$ref": "#/$defs/mirrors"
    },
    "mirror_policy": {
      "enum": [
        "race",
        "strict-priority"
      ]
    },
    "file_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paths"
        ],
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mirror_policy": {
            "enum": [
              "race",
              "strict-priority"
            ]
          },
          "sources": {
            "$ref": "#/$defs/mirrors"
          }
        }
      }
    },
    "prebuilt": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fallbackSet"
      }
    },
    "onnx_prebuilt": {
      "$ref": "#/$defs/onnx_prebuilt"
    },
    "post_install": {
      "$ref": "#/$defs/post_install"
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_vram_gib",
        "recommended_vram_gib",
        "gpu_min_cc"
      ],
      "properties": {
        "min_vram_gib": {
          "type": "number",
          "minimum": 0
        },
        "recommended_vram_gib": {
          "type": "number",
          "minimum": 0
        },
        "gpu_min_cc": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "version_req"
      ],
      "properties": {
        "engine": {
          "enum": [
            "llama.cpp",
            "diffusers",
            "nunchaku",
            "onnxruntime"
          ]
        },
        "version_req": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "base_model": {
      "type": "string"
    },
    "card_url": {
      "type": "string",
      "pattern": "^(?:|https://\\S+)$"
    },
    "flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "on_demand": {
      "type": "boolean"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forge_version",
        "tag",
        "date"
      ],
      "properties": {
        "forge_version": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "description": "Release tag, or an empty string when this build is unreleased."
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  },
  "$defs": {
    "mirror": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "revision"
      ],
      "properties": {
        "kind": {
          "enum": [
            "hf",
            "kaggle",
            "gdrive",
            "modelscope",
            "url"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string"
        },
        "ours": {
          "type": "boolean"
        }
      }
    },
    "mirrors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mirror"
      }
    },
    "fallbackSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "replaces",
        "files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "replaces": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "size",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!voxprint-model\\.json$)(?!/)(?!.*\\\\)(?!.*\\.\\./)[^\\\\]+$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "mirror_policy": {
                "enum": [
                  "race",
                  "strict-priority"
                ]
              },
              "sources": {
                "$ref": "#/$defs/mirrors"
              }
            }
          }
        }
      }
    },
    "onnx_prebuilt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "built_for"
      ],
      "oneOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "sources"
          ]
        }
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!voxprint-model\\.json$)(?!/)(?!.*\\\\)(?!.*\\.\\./)[^\\\\]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "url": {
          "type": "string",
          "pattern": "^https://\\S+$"
        },
        "sources": {
          "$ref": "#/$defs/mirrors"
        },
        "mirror_policy": {
          "enum": [
            "race",
            "strict-priority"
          ]
        },
        "built_for": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "onnxruntime",
            "opset"
          ],
          "properties": {
            "onnxruntime": {
              "type": "string",
              "minLength": 1
            },
            "opset": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "post_install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cli",
        "args"
      ],
      "properties": {
        "cli": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[^{}]|\\{(?:id|model_dir|source_path|prebuilt_path|cache_dir)\\})*$"
          }
        },
        "timeout_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!(?:.*/)?\\.\\.(?:/|$)).+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
